//============================================================
// MODULE 1: 32-bit Carry Look-Ahead Adder
//============================================================

module CLA_Adder_32bit (
    input  [31:0] A,
    input  [31:0] B,
    input         Cin,
    output [31:0] Sum,
    output        Cout
);

    wire [31:0] G, P;
    wire [32:0] C;

    // Generate and Propagate signals
    assign G = A & B;
    assign P = A ^ B;

    // Initial carry input
    assign C[0] = Cin;

    // Carry generation logic
    assign C[1]  = G[0]  | (P[0]  & C[0]);
    assign C[2]  = G[1]  | (P[1]  & C[1]);
    assign C[3]  = G[2]  | (P[2]  & C[2]);
    assign C[4]  = G[3]  | (P[3]  & C[3]);
    assign C[5]  = G[4]  | (P[4]  & C[4]);
    assign C[6]  = G[5]  | (P[5]  & C[5]);
    assign C[7]  = G[6]  | (P[6]  & C[6]);
    assign C[8]  = G[7]  | (P[7]  & C[7]);
    assign C[9]  = G[8]  | (P[8]  & C[8]);
    assign C[10] = G[9]  | (P[9]  & C[9]);
    assign C[11] = G[10] | (P[10] & C[10]);
    assign C[12] = G[11] | (P[11] & C[11]);
    assign C[13] = G[12] | (P[12] & C[12]);
    assign C[14] = G[13] | (P[13] & C[13]);
    assign C[15] = G[14] | (P[14] & C[14]);
    assign C[16] = G[15] | (P[15] & C[15]);
    assign C[17] = G[16] | (P[16] & C[16]);
    assign C[18] = G[17] | (P[17] & C[17]);
    assign C[19] = G[18] | (P[18] & C[18]);
    assign C[20] = G[19] | (P[19] & C[19]);
    assign C[21] = G[20] | (P[20] & C[20]);
    assign C[22] = G[21] | (P[21] & C[21]);
    assign C[23] = G[22] | (P[22] & C[22]);
    assign C[24] = G[23] | (P[23] & C[23]);
    assign C[25] = G[24] | (P[24] & C[24]);
    assign C[26] = G[25] | (P[25] & C[25]);
    assign C[27] = G[26] | (P[26] & C[26]);
    assign C[28] = G[27] | (P[27] & C[27]);
    assign C[29] = G[28] | (P[28] & C[28]);
    assign C[30] = G[29] | (P[29] & C[29]);
    assign C[31] = G[30] | (P[30] & C[30]);
    assign C[32] = G[31] | (P[31] & C[31]);

    // Sum and Carry output
    assign Sum  = P ^ C[31:0];
    assign Cout = C[32];

endmodule


//============================================================
// MODULE 2: 32-bit Arithmetic Logic Unit
//============================================================

module ALU_32bit (
    input  [31:0] A,
    input  [31:0] B,
    input  [2:0]  Opcode,
    input         Clk,
    input         Enable,

    output reg [31:0] Result,
    output reg        Cout
);

    // Internal signals
    wire [31:0] CLA_Sum;
    wire        CLA_Cout;

    reg [1:0] Power_Mode;
    reg       Clk_Scaled;

    reg [31:0] B_comp_isolated;

    // Clock divider counter
    reg [1:0] div_count;

    // Clock division counter
    always @(posedge Clk) begin
        div_count <= div_count + 1'b1;
    end

    // Clock frequency selection
    // 00 = Clock / 4
    // 01 = Clock / 2
    // 10 = Original Clock

    always @(*) begin

        case (Power_Mode)

            2'b00: Clk_Scaled = div_count[1];
            2'b01: Clk_Scaled = div_count[0];
            2'b10: Clk_Scaled = Clk;

            default: Clk_Scaled = Clk;

        endcase

    end

    // Subtraction preparation
    // A - B = A + (~B) + 1

    always @(*) begin

        if (Opcode == 3'b001)
            B_comp_isolated = ~B;
        else
            B_comp_isolated = B;

    end

    // CLA Adder instantiation

    CLA_Adder_32bit CLA (
        .A    (A),
        .B    (B_comp_isolated),
        .Cin  (Opcode == 3'b001),
        .Sum  (CLA_Sum),
        .Cout (CLA_Cout)
    );

    // ALU operation control

    always @(posedge Clk_Scaled) begin

        if (Enable) begin

            case (Opcode)

                // Addition
                3'b000: begin
                    Result <= CLA_Sum;
                    Cout   <= CLA_Cout;
                end

                // Subtraction
                3'b001: begin
                    Result <= CLA_Sum;
                    Cout   <= ~CLA_Cout;
                end

                // AND operation
                3'b010: begin
                    Result <= A & B;
                    Cout   <= 1'b0;
                end

                // OR operation
                3'b011: begin
                    Result <= A | B;
                    Cout   <= 1'b0;
                end

                // XOR operation
                3'b100: begin
                    Result <= A ^ B;
                    Cout   <= 1'b0;
                end

                // NOT operation
                3'b101: begin
                    Result <= ~A;
                    Cout   <= 1'b0;
                end

                // Default operation
                default: begin
                    Result <= 32'b0;
                    Cout   <= 1'b0;
                end

            endcase

        end

        else begin

            Result <= 32'b0;
            Cout   <= 1'b0;

        end

    end

endmodule
